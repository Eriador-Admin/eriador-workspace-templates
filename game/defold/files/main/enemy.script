-- Enemy script for {{PROJECT_NAME}}
-- Moves downward, destroys when off screen

go.property("speed", 120)

function init(self)
    self.speed = self.speed + math.random(-20, 40)
end

function update(self, dt)
    local pos = go.get_position()
    pos.y = pos.y - self.speed * dt
    go.set_position(pos)

    if pos.y < -30 then
        go.delete()
    end
end

function on_message(self, message_id, message, sender)
    if message_id == hash("hit") then
        go.delete()
    end
end
