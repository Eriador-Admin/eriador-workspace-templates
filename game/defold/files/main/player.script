-- Player script for {{PROJECT_NAME}}
-- Handles movement and shooting

go.property("speed", 300)

local SHOOT_INTERVAL = 0.25

function init(self)
    msg.post(".", "acquire_input_focus")
    self.input = { left = false, right = false, up = false, down = false, shoot = false }
    self.shoot_timer = 0
end

function update(self, dt)
    local pos = go.get_position()
    local dx, dy = 0, 0

    if self.input.left then dx = dx - 1 end
    if self.input.right then dx = dx + 1 end
    if self.input.up then dy = dy + 1 end
    if self.input.down then dy = dy - 1 end

    -- Normalize diagonal
    if dx ~= 0 and dy ~= 0 then
        local len = math.sqrt(dx * dx + dy * dy)
        dx = dx / len
        dy = dy / len
    end

    pos.x = pos.x + dx * self.speed * dt
    pos.y = pos.y + dy * self.speed * dt

    -- Clamp to screen
    pos.x = math.max(16, math.min(pos.x, 784))
    pos.y = math.max(16, math.min(pos.y, 584))

    go.set_position(pos)

    -- Shooting
    self.shoot_timer = self.shoot_timer - dt
    if self.input.shoot and self.shoot_timer <= 0 then
        self.shoot_timer = SHOOT_INTERVAL
        local bullet_pos = vmath.vector3(pos.x, pos.y + 20, 0)
        factory.create("#bullet_factory", bullet_pos)
    end
end

function on_input(self, action_id, action)
    if action_id == hash("left") then
        self.input.left = not action.released
    elseif action_id == hash("right") then
        self.input.right = not action.released
    elseif action_id == hash("up") then
        self.input.up = not action.released
    elseif action_id == hash("down") then
        self.input.down = not action.released
    elseif action_id == hash("shoot") then
        self.input.shoot = not action.released
    end
end
