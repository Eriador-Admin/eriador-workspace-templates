{
  "dashboard": {
    "title": "App Metrics",
    "panels": [
      {
        "title": "Request Rate",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "targets": [
          { "expr": "rate(http_requests_total[1m])", "legendFormat": "{{method}} {{route}} {{status}}" }
        ]
      },
      {
        "title": "Request Duration (p95)",
        "type": "timeseries",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "targets": [
          { "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "p95" }
        ]
      },
      {
        "title": "Total Requests",
        "type": "stat",
        "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
        "targets": [
          { "expr": "sum(http_requests_total)" }
        ]
      },
      {
        "title": "Process Memory",
        "type": "timeseries",
        "gridPos": { "x": 6, "y": 8, "w": 18, "h": 4 },
        "targets": [
          { "expr": "process_resident_memory_bytes / 1024 / 1024", "legendFormat": "RSS (MB)" }
        ]
      }
    ],
    "time": { "from": "now-15m", "to": "now" },
    "refresh": "5s"
  }
}
