worker_processes {{ nginx_worker_processes }};

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;

    server {
        listen {{ nginx_port }};
        server_name {{ nginx_server_name }};

        location / {
            root /var/www/html;
            index index.html;
        }
    }
}
