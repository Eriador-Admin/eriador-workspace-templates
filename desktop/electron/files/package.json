{
  "name": "{{APP_NAME}}",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite --port {{DEV_PORT}}",
    "dev:main": "tsc -p tsconfig.main.json && electron . --dev",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "typescript": "^5.3.0",
    "vite": "^8.3.6"
  }
}
